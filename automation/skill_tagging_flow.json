        "messages": {
          "messageValues": [
            {
              "content": "=Please extract the core technical skills from this profile. Return a comma-separated list of 3-5 tags. Profile details: Name: {{$json[\"Name\"]}}, Experience: {{$json[\"Experience (Years)\"]}}, Skills: {{$json[\"Skills\"]}}"
            }
          ]
        }
      },
      "id": "847b3191-dc1d-4034-8c83-0583ef4a47d1",
