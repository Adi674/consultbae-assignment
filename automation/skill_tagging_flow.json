      "position": [
        620,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE persons SET skills = $json[\"message\"][\"content\"] WHERE email = '{{$json[\"Email\"]}}' OR phone = '{{$json[\"Phone\"]}}';"
      },
      "id": "99f3c1a4-bb5d-4f11-9a72-0f5a7e1f4b82",
      "name": "SQLite Update DB",
